{
  "name": "radix-dex",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "tsx --test packages/core/test/*.test.ts apps/server/test/*.test.ts",
    "server": "tsx apps/server/src/main.ts",
    "web": "npm run dev -w apps/web",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
