# Environment for the OwnerPool bot and watcher user units (deploy/owner-pool-bot.service,
# deploy/owner-pool-watch.service). Copy to ~/.config/radix-dex/owner-pool.env, mode 600:
#   install -m 600 deploy/owner-pool.env.example ~/.config/radix-dex/owner-pool.env
# and fill it in. This file is read by systemd (EnvironmentFile=): KEY=value, no quotes, no spaces
# around "=". Runbook: docs/MAINNET-POOLS.md.

# Alerts: an ntfy-style URL that takes a plain-text POST. The owner chose the existing valwatch ntfy
# topic. Its value is NOT in this repository: it is the `ntfy_url` line of /etc/valwatch.conf on
# the valwatch host (DIFD5). Copy it here by hand. Leave empty and nothing is sent.
OWNER_POOL_BOT_ALERT_URL=

# The pool and its operator badge, from `tsx scripts/mainnet-owner-pool.ts status` once recorded.
OWNER_POOL=component_rdx1...
OWNER_POOL_OPERATOR_BADGE=resource_rdx1...

# Extra flags for the bot. Empty = DRY RUN (reads, decides, previews, sends nothing). The bot
# refuses --send off Stokenet until the code change in docs/MAINNET-POOLS.md ("Going live") is made
# with the owner's go-ahead.
OWNER_POOL_BOT_FLAGS=

# Extra flags for the watcher (e.g. --max-pool-drift 0.03). Usually empty.
OWNER_POOL_WATCH_FLAGS=
