{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "noEmit": true, "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true, "types": ["node"]
  },
  "include": ["packages/*/src", "packages/*/test", "apps/server/src", "apps/server/test"]
}
